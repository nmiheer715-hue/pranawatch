# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets
GEMINI_API_KEY = "paste-your-key-from-aistudio.google.com/apikey"
# GEMINI_MODEL = "gemini-2.5-flash"      # optional override
# EE_PROJECT = "your-google-cloud-project-id"   # optional, for live Earth Engine layers
# FIRMS_MAP_KEY = "free key from firms.modaps.eosdis.nasa.gov/api/map_key"  # optional, live fires
# DATA_GOV_IN_KEY = "free key from data.gov.in (My Account -> API key)"  # optional, CPCB ground stations
# BQ_PROJECT = "your-google-cloud-project-id"  # optional, BigQuery export (defaults to EE_PROJECT)
